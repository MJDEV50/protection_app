# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=refuge_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=refuge-app-prod

# External APIs
DALLE_API_KEY=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
SENDGRID_API_KEY=
SENDER_EMAIL=noreply@refuge-app.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Features
ENABLE_FAKE_CALL=true
ENABLE_SAFE_WALK=true
ENABLE_AUDIO_RECORDING=true

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=refuge-media
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

